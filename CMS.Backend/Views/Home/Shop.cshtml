@model IEnumerable<CMS.Data.Entities.Product>
@{
    ViewData["Title"] = "Cửa hàng - Mai Trinh Store";
}

<div class="container my-5">
    <div class="row g-4">

        <div class="col-md-3">
            <div class="filter-sidebar p-3 border rounded-3 bg-white shadow-sm">
                <div class="filter-group mb-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-grid-fill text-secondary"></i> Danh Mục
                    </h5>
                    <ul class="list-unstyled lh-lg">
                        <li><a href="/Home/Shop" class="text-decoration-none text-secondary d-block"><i class="bi bi-chevron-right small"></i> Tất cả sản phẩm</a></li>
                        <li><a href="/Home/Shop?categoryId=1001" class="text-decoration-none text-secondary d-block"><i class="bi bi-chevron-right small"></i> Thời trang Nam</a></li>
                        <li><a href="/Home/Shop?categoryId=1002" class="text-decoration-none text-secondary d-block"><i class="bi bi-chevron-right small"></i> Thời trang Nữ</a></li>
                        <li><a href="/Home/Shop?categoryId=1032" class="text-decoration-none text-secondary d-block"><i class="bi bi-chevron-right small"></i> Nước hoa Nam</a></li>
                        <li><a href="/Home/Shop?categoryId=1033" class="text-decoration-none text-secondary d-block"><i class="bi bi-chevron-right small"></i> Nước hoa Nữ</a></li>
                    </ul>
                </div>

                <div class="filter-group mb-3">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3" id="sizeFilterTitle">
                        <i class="bi bi-sliders text-secondary"></i> Kích Cỡ
                    </h5>
                    <div id="dynamicSizeContainer" class="d-flex flex-column gap-2">
                        <div class="text-muted small"><i class="bi bi-arrow-repeat spin"></i> Đang tải bộ lọc...</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold text-uppercase text-dark" id="pageMainTitle">SẢN PHẨM CỬA HÀNG</h4>
                <span class="text-muted small">Tìm thấy <b>@Model.Count()</b> sản phẩm</span>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-secondary text-center py-5 rounded-3">
                    <i class="bi bi-box-open display-4 text-muted d-block mb-3"></i>
                    Chưa có sản phẩm nào trong mục này.
                </div>
            }
            else
            {
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-2 g-3">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm product-item-card">
                                <div class="position-relative bg-light text-center">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" style="height: 250px; object-fit: cover; width: 100%;">
                                    <span class="position-absolute bottom-0 start-0 m-2 badge bg-dark opacity-75">@item.Brand</span>
                                </div>
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1 text-truncate-2" style="height: 42px; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                            @item.Name
                                        </h6>
                                        <p class="text-muted small text-truncate mb-2">@item.Material</p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="text-danger fw-bold fs-5">@item.Price.ToString("N0")đ</span>
                                        <a href="/Product/Details/@item.Id" class="btn btn-sm btn-dark px-3 rounded-pill">Xem</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        let categoryId = urlParams.get('categoryId');

        if (!categoryId) {
            categoryId = 1032; // Mặc định nếu xem tất cả sẽ mồi bộ lọc nước hoa nam
        }

        // Cập nhật tiêu đề trang và bộ lọc dựa trên mã ngành hàng
        const sizeTitle = document.getElementById("sizeFilterTitle");
        const pageTitle = document.getElementById("pageMainTitle");

        if (categoryId == 1032 || categoryId == 1033) {
            sizeTitle.innerHTML = '<i class="bi bi-droplet-fill text-primary"></i> Dung Tích';
            pageTitle.innerText = "Nước hoa cao cấp";
        } else {
            sizeTitle.innerHTML = '<i class="bi bi-rulers text-primary"></i> Kích Thước';
            pageTitle.innerText = "Thời trang xu hướng";
        }

        // Gọi API AJAX kết nối với hàm xử lý ở C# Controller
        fetch(`/Product/GetSizesByCategory?categoryId=${categoryId}`)
            .then(response => response.json())
            .then(data => {
                const container = document.getElementById("dynamicSizeContainer");
                container.innerHTML = "";

                if (data.length === 0) {
                    container.innerHTML = '<div class="text-muted small">Không có kích cỡ</div>';
                    return;
                }

                // Vẽ các ô checkbox đơn lẻ ra màn hình
                data.forEach(size => {
                    const div = document.createElement("div");
                    div.className = "form-check d-flex align-items-center";
                    div.innerHTML = `
                        <input class="form-check-input me-2" type="checkbox" value="${size}" id="size_${size}">
                        <label class="form-check-label text-secondary fw-semibold" style="cursor:pointer;" for="size_${size}">${size}</label>
                    `;
                    container.appendChild(div);
                });
            })
            .catch(error => {
                console.error("Lỗi:", error);
                document.getElementById("dynamicSizeContainer").innerHTML = '<div class="text-danger small">Lỗi tải dữ liệu</div>';
            });
    });
</script>

<style>
    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    .spin {
        animation: spin 1s linear infinite;
        display: inline-block;
    }

    .product-item-card {
        transition: all 0.3s ease;
    }

        .product-item-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>