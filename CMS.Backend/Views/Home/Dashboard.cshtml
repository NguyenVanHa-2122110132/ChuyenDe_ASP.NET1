@*
    Họ và tên: Nguyễn Văn Hà
    MSSV     : 2122110132
    Lớp      : CCQ2211D
    Ngày tạo : 16/05/2026
    Mô tả    : Trang Bảng điều khiển (Dashboard) trong khu vực Admin.
              - Hiển thị tổng quan số lượng: Danh mục, Bài viết, Thành viên
              - Mỗi thống kê hiển thị dạng Card với màu sắc phân biệt
              - Nhận dữ liệu từ HomeController (action Dashboard) thông qua ViewBag
*@

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bảng điều khiển";
}

<h2 class="mb-4">Bảng điều khiển</h2>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Danh mục</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalCategories</h2>
                </div>
                <i class="bi bi-grid fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Category" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Bài viết</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalPosts</h2>
                </div>
                <i class="bi bi-file-earmark-post fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Post" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-danger shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Khách hàng</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalCustomers</h2>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Customer" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Mã giảm giá</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalCoupons</h2>
                </div>
                <i class="bi bi-ticket-perforated fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Coupon" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-info shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Tồn kho</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalInventory</h2>
                </div>
                <i class="bi bi-box-seam fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Inventory" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-secondary shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="card-title mb-1 fs-6">Bình luận</p>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalComments</h2>
                </div>
                <i class="bi bi-chat-dots fs-1 opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Comment" asp-action="Index"
                   class="text-white text-decoration-none small">
                    Xem chi tiết →
                </a>
            </div>
        </div>
    </div>
</div>
</div>