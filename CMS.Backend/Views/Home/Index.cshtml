*@
@model IEnumerable<CMS.Data.Entities.Post>
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    .product-card {
        border: 1px solid #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.3s ease;
        background: #fff;
    }

        .product-card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            transform: translateY(-5px);
        }

        .product-card img {
            height: 200px;
            object-fit: cover;
            width: 100%;
            transition: transform 0.3s ease;
        }

        .product-card:hover img {
            transform: scale(1.05);
        }

    .badge-category {
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 20px;
    }

    .price-tag {
        color: #e31837;
        font-size: 18px;
        font-weight: 700;
    }

    .section-title {
        position: relative;
        display: inline-block;
        padding-bottom: 10px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: #e31837;
        }

    .flash-sale-banner {
        background: linear-gradient(135deg, #e31837, #ff6b35);
        color: white;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.8;
        }

        100% {
            opacity: 1;
        }
    }

    .feature-box {
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        transition: transform 0.3s;
    }

        .feature-box:hover {
            transform: translateY(-5px);
        }

    .hero-banner {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: white;
        padding: 60px 0;
        border-radius: 16px;
        margin-bottom: 30px;
    }
</style>

<!-- PHẦN 1: HERO BANNER -->
<div class="hero-banner text-center mb-4">
    <div class="container">
        <div class="mb-3">
            <span class="flash-sale-banner">
                🔥 THỨ BA - SALE SẬP SÀN - GIẢM ĐẾN 50%
            </span>
        </div>
        <h1 class="display-4 fw-bold text-white mt-3">
            <i class="bi bi-phone-vibrate text-danger"></i>
            MAI TRINH MOBILE
        </h1>
        <p class="fs-5 text-white-50 col-md-8 mx-auto mt-2">
            Thiên đường điện thoại công nghệ cao cấp. Cập nhật những mẫu smartphone
            mới nhất, chính hãng với giá ưu đãi nhất 2026.
        </p>
        <div class="mt-4">
            <a href="/Product" class="btn btn-danger btn-lg px-5 me-3 shadow">
                <i class="bi bi-bag-check-fill"></i> Mua ngay
            </a>
            <a href="/Category" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-list-ul"></i> Xem danh mục
            </a>
        </div>
    </div>
</div>

<!-- PHẦN 2: THANH DANH MỤC NHANH -->
<div class="container mb-4">
    <div class="d-flex gap-2 flex-wrap justify-content-center">
        <a href="/Product" class="btn btn-outline-danger rounded-pill px-4">📱 Điện thoại</a>
        <a href="/Category" class="btn btn-outline-secondary rounded-pill px-4">🍎 Apple</a>
        <a href="/Category" class="btn btn-outline-secondary rounded-pill px-4">📟 Samsung</a>
        <a href="/Category" class="btn btn-outline-secondary rounded-pill px-4">🔷 Xiaomi</a>
        <a href="/Category" class="btn btn-outline-secondary rounded-pill px-4">🟢 Oppo</a>
        <a href="/Category" class="btn btn-outline-secondary rounded-pill px-4">🔵 Vivo</a>
    </div>
</div>

<!-- PHẦN 3: TÍNH NĂNG NỔI BẬT -->
<div class="container mb-5">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="feature-box bg-dark text-white h-100">
                <i class="bi bi-shield-check display-5 text-warning"></i>
                <h5 class="mt-3 fw-bold">Chính hãng 100%</h5>
                <p class="text-white-50 small">Cam kết nguyên seal, đầy đủ phụ kiện và bảo hành chính hãng.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box bg-light border h-100">
                <i class="bi bi-truck display-5 text-primary"></i>
                <h5 class="mt-3 fw-bold">Giao hàng siêu tốc</h5>
                <p class="text-muted small">Nhận hàng trong 2h nội thành, miễn phí vận chuyển trên 5 triệu.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box bg-danger text-white h-100">
                <i class="bi bi-headset display-5"></i>
                <h5 class="mt-3 fw-bold">Hỗ trợ 24/7</h5>
                <p class="small" style="opacity:0.8">Tư vấn viên luôn sẵn sàng giải đáp mọi thắc mắc.</p>
            </div>
        </div>
    </div>
</div>

<!-- PHẦN 4: TIN TỨC MỚI NHẤT -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold section-title">⚡ TIN TỨC MỚI NHẤT</h4>
        <a href="/Post" class="btn btn-outline-danger btn-sm">Xem tất cả →</a>
    </div>
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var plainText = System.Text.RegularExpressions.Regex.Replace(
            item.Content ?? "", "<.*?>", ""
            );
            <div class="col-md-4 col-6">
                <div class="product-card h-100">
                    <div class="position-relative overflow-hidden">
                        <img src="@item.ImageUrl" alt="@item.Title">
                        <span class="position-absolute top-0 start-0 m-2 badge bg-danger badge-category">
                            @item.Category?.Name
                        </span>
                    </div>
                    <div class="p-3">
                        <h6 class="fw-bold mb-1" style="line-height:1.4">@item.Title</h6>
                        <p class="text-muted small mb-2" style="
                                display:-webkit-box;
                                -webkit-line-clamp:2;
                                -webkit-box-orient:vertical;
                                overflow:hidden">
                            @plainText
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">
                                <i class="bi bi-calendar3"></i>
                                @item.CreatedDate.ToString("dd/MM/yyyy")
                            </small>
                            <a href="/Post/Details/@item.Id" class="btn btn-danger btn-sm px-3">
                                Xem
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>