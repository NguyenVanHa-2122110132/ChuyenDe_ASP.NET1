@*
    Họ và tên: Nguyễn Văn Hà
    MSSV     : 2122110132
    Lớp      : CCQ2211D
    Ngày tạo : 18/05/2026
    Mô tả    : Trang thêm mới Chi tiết Đơn hàng trong khu vực Admin.
              - Hiển thị form nhập liệu gồm: Đơn hàng, Sản phẩm, Số lượng, Đơn giá
              - Đơn hàng và Sản phẩm chọn từ dropdown load từ database
              - Khi bấm Lưu sẽ gửi POST request đến OrderDetailController (action Create)
              - Khi bấm Hủy bỏ sẽ trở về trang danh sách OrderDetail
*@
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm chi tiết đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary mb-0">THÊM CHI TIẾT ĐƠN HÀNG</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label class="form-label fw-bold">Đơn hàng:</label>
                <select name="OrderId" asp-items="ViewBag.Orders" class="form-select">
                    <option value="">-- Chọn đơn hàng --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Sản phẩm:</label>
                <select name="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng:</label>
                <input name="Quantity" type="number" min="1" class="form-control"
                       placeholder="Nhập số lượng..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Đơn giá (VNĐ):</label>
                <input name="UnitPrice" type="number" min="0" class="form-control"
                       placeholder="Nhập đơn giá..." />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Lưu vào hệ thống
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>

        </form>
    </div>
</div>