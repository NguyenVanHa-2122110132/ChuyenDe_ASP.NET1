    Ngày tạo : 18/05/2026
    Mô tả    : Trang chỉnh sửa Chi tiết Đơn hàng trong khu vực Admin.
              - Hiển thị form với dữ liệu cũ được điền sẵn để chỉnh sửa
              - Bắt buộc có input hidden Id để Entity Framework biết sửa đúng dòng
              - Đơn hàng và Sản phẩm chọn từ dropdown, tự chọn đúng giá trị cũ
              - Khi bấm Cập nhật sẽ gửi POST request đến OrderDetailController (action Edit)
              - Khi bấm Hủy bỏ sẽ trở về trang danh sách OrderDetail
*@
@model CMS.Data.Entities.OrderDetail

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa chi tiết đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-warning mb-0">SỬA CHI TIẾT ĐƠN HÀNG</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Đơn hàng:</label>
                <select asp-for="OrderId" asp-items="ViewBag.Orders" class="form-select">
                    <option value="">-- Chọn đơn hàng --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Sản phẩm:</label>
                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng:</label>
                <input asp-for="Quantity" type="number" min="1" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Đơn giá (VNĐ):</label>
                <input asp-for="UnitPrice" type="number" min="0" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>

        </form>
    </div>
</div>