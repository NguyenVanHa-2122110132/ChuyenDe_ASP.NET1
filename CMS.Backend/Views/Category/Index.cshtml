    Mô tả    : Trang danh sách Danh mục trong khu vực Admin.
              - Nhận dữ liệu từ CategoryController (action Index) dưới dạng IEnumerable<Category>
              - Hiển thị toàn bộ danh mục dưới dạng bảng gồm: STT, Tên, Mô tả, Thao tác
              - Nút "Thêm mới" dẫn đến trang Create
              - Nút "Sửa" dẫn đến trang Edit theo từng ID
              - Nút "Xóa" gửi POST request xóa danh mục, có hộp thoại xác nhận trước khi xóa
              - Hiển thị thông báo lỗi (ErrorMessage) từ TempData nếu xóa thất bại
*@
@model IEnumerable<CMS.Data.Entities.Category>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh mục";
    int stt = 1;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">DANH SÁCH DANH MỤC</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
        </a>
    </div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Lỗi:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th class="text-center">STT</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@stt</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <form asp-action="Delete" method="post"
                              style="display:inline"
                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </form>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>