    Mô tả    : Trang thêm mới Danh mục trong khu vực Admin.
              - Hiển thị form nhập liệu gồm: Tên danh mục, Mô tả
              - Khi bấm Lưu sẽ gửi POST request đến CategoryController (action Create)
              - Khi bấm Hủy bỏ sẽ trở về trang danh sách Category
*@
@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục";
}

<div class="container mt-4">
    <h2 class="text-primary">THÊM DANH MỤC MỚI</h2>
    <hr />
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Tên danh mục:</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Mô tả:</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-save"></i> Lưu vào hệ thống
        </button>
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>