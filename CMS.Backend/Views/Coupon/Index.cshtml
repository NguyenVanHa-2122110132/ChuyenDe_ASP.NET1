            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td><strong>SALE10</strong></td>
                <td>10%</td>
                <td>31/12/2026</td>
                <td><span class="badge bg-success">Còn hiệu lực</span></td>
                <td>
                    <button class="btn btn-warning btn-sm">✏️ Sửa</button>
                    <button class="btn btn-danger btn-sm">🗑️ Xóa</button>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td><strong>FREESHIP</strong></td>
                <td>Miễn phí ship</td>
                <td>30/06/2026</td>
                <td><span class="badge bg-danger">Hết hạn</span></td>
                <td>
                    <button class="btn btn-warning btn-sm">✏️ Sửa</button>
                    <button class="btn btn-danger btn-sm">🗑️ Xóa</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>