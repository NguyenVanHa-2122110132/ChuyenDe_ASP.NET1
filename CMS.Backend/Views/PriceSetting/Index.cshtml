@model CMS.Data.Entities.PriceSetting
@{
    ViewData["Title"] = "Cấu hình khoảng giá";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold">⚙️ CẤU HÌNH KHOẢNG GIÁ</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">🏷️ Khoảng giá hiển thị trên trang Shop React</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="/PriceSetting/Save">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nhãn mô tả</label>
                            <input type="text" name="label" value="@Model.Label"
                                   class="form-control" placeholder="Ví dụ: Thời trang, Nước hoa..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá tối thiểu (₫)</label>
                            <input type="number" name="minPrice" value="@Model.MinPrice"
                                   class="form-control" min="0" step="1000" />
                            <small class="text-muted">Hiện tại: @Model.MinPrice.ToString("N0")₫</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá tối đa (₫)</label>
                            <input type="number" name="maxPrice" value="@Model.MaxPrice"
                                   class="form-control" min="0" step="1000" />
                            <small class="text-muted">Hiện tại: @Model.MaxPrice.ToString("N0")₫</small>
                        </div>

                        <div class="alert alert-info">
                            <small>
                                📌 Khoảng giá này sẽ hiển thị làm gợi ý trên trang lọc sản phẩm của React.<br />
                                Cập nhật lúc: <strong>@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            </small>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">
                            💾 Lưu cấu hình
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Preview -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">👁️ Xem trước hiển thị trên React</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">Khách hàng sẽ thấy gợi ý:</p>
                    <div style="border:1px solid #e4ddd4; padding:16px; background:#f7f3ee;">
                        <span style="font-size:0.75rem; color:#8a8178; font-weight:600; text-transform:uppercase; letter-spacing:1px;">
                            KHOẢNG GIÁ
                        </span>
                        <p style="color:#8a8178; font-size:0.78rem; margin:4px 0 12px 0;">
                            @Model.MinPrice.ToString("N0")₫ – @Model.MaxPrice.ToString("N0")₫
                        </p>
                        <div style="display:flex; gap:8px;">
                            <input type="text" placeholder="Từ" style="width:45%; padding:8px; border:1px solid #e4ddd4;" readonly />
                            <span>—</span>
                            <input type="text" placeholder="Đến" style="width:45%; padding:8px; border:1px solid #e4ddd4;" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>