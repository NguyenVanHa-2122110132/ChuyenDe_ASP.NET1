    Ngày tạo : 16/05/2026
    Mô tả    : Trang chỉnh sửa Thành viên trong khu vực Admin.
              - Hiển thị form với dữ liệu cũ được điền sẵn để chỉnh sửa
              - Bắt buộc có input hidden Id để Entity Framework biết sửa đúng dòng
              - Quyền hạn chọn từ dropdown: Administrator, Editor, Author
              - Khi bấm Cập nhật sẽ gửi POST request đến UserController (action Edit)
              - Khi bấm Hủy bỏ sẽ trở về trang danh sách User
*@
@model CMS.Data.Entities.User

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa thành viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-warning mb-0">SỬA THÀNH VIÊN</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Tên đăng nhập:</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu:</label>
                <input asp-for="PasswordHash" type="password" class="form-control" />
                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Họ và tên:</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Quyền hạn:</label>
                <select asp-for="Role" class="form-select">
                    <option value="">-- Chọn quyền hạn --</option>
                    <option value="Administrator">Administrator</option>
                    <option value="Editor">Editor</option>
                    <option value="Author">Author</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>

        </form>
    </div>
</div>