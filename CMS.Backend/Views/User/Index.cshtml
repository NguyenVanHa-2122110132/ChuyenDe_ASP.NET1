@*
    Họ và tên: Nguyễn Văn Hà
    MSSV     : 2122110132
    Lớp      : CCQ2211D
    Ngày tạo : 16/05/2026
    Mô tả    : Trang danh sách Nhân viên trong khu vực Admin.
              - Administrator: xem + sửa + xóa
              - Nhân viên khác: chỉ xem Họ tên, Quyền hạn (không có Sửa/Xóa)
              - Không hiển thị Customer (đã tách sang trang Quản lý Khách hàng)
              [BẢO MẬT] Nút Xóa dùng form POST + AntiForgeryToken
*@
@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thành viên";
    bool isAdmin = User.IsInRole("Administrator");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i> QUẢN LÝ NHÂN VIÊN
        </h2>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Thêm thành viên mới
            </a>
        }
    </div>

    @* Hiển thị thông báo lỗi nếu có (ví dụ: không tự xóa chính mình) *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-hover shadow-sm border">
        <thead class="table-dark">
            <tr>
                @if (isAdmin)
                {
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                }
                <th>Họ và tên</th>
                <th>Quyền hạn</th>
                @if (isAdmin)
                {
                    <th>Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@user.Id</td>
                        <td><strong>@user.Username</strong></td>
                    }
                    <td>@user.FullName</td>
                    <td>
                        @{
                            var (badgeColor, icon) = user.Role switch
                            {
                                            "Administrator" => ("bg-danger", "bi-shield-fill"),
                                            "Admin" => ("bg-danger", "bi-shield-fill"),
                                            "Sales" => ("bg-success", "bi-bag-fill"),
                                            "Cashier" => ("bg-warning text-dark", "bi-cash-coin"),
                                            "Warehouse" => ("bg-secondary", "bi-box-seam"),
                                            "Technician" => ("bg-info text-dark", "bi-tools"),
                                            "Shipper" => ("bg-primary", "bi-truck"),
                                            "Staff" => ("bg-info text-dark", "bi-person-badge"),
                                _ => ("bg-secondary", "bi-person")
                            };
                        }
                        <span class="badge @badgeColor px-3 py-2">
                            <i class="bi @icon me-1"></i> @user.Role
                        </span>
                    </td>
                    @if (isAdmin)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>

                            @* [BẢO MẬT] Dùng form POST thay vì link GET để tránh CSRF *@
                            <form asp-action="Delete" asp-route-id="@user.Id"
                                  method="post" style="display:inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa thành viên này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>