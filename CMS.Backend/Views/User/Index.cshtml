@*
    Họ và tên: Nguyễn Văn Hà
    MSSV     : 2122110132
    Lớp      : CCQ2211D
    Ngày tạo : 16/05/2026
    Mô tả    : Trang danh sách Thành viên trong khu vực Admin.
              - Nhận dữ liệu từ UserController (action Index) dưới dạng IEnumerable<User>
              - Hiển thị danh sách tất cả thành viên gồm: ID, Tên đăng nhập, Họ tên, Quyền hạn
              - Phân biệt quyền hạn bằng màu badge: đỏ (Administrator), vàng (Editor), xanh (Author)
              - Nút "Thêm mới" dẫn đến trang Create
              - Nút "Sửa" dẫn đến trang Edit theo từng ID
              - Nút "Xóa" gọi GET request xóa thành viên, có hộp thoại xác nhận trước khi xóa
*@
@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thành viên";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark mb-0">QUẢN LÝ THÀNH VIÊN</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm thành viên mới
        </a>
    </div>
    <table class="table table-hover shadow-sm border">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên đăng nhập</th>
                <th>Họ và tên</th>
                <th>Quyền hạn</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td><strong>@user.Username</strong></td>
                    <td>@user.FullName</td>
                    <td>
                        @if (user.Role == "Administrator")
                        {
                            <span class="badge bg-danger">@user.Role</span>
                        }
                        else if (user.Role == "Editor")
                        {
                            <span class="badge bg-warning text-dark">@user.Role</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@user.Role</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này?')">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>