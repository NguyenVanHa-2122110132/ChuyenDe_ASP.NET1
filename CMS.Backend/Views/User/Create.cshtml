    Ngày tạo : 16/05/2026
    Mô tả    : Trang thêm mới Thành viên trong khu vực Admin.
              - Hiển thị form nhập liệu gồm: Tên đăng nhập, Mật khẩu, Họ tên, Quyền hạn
              - Quyền hạn chọn từ dropdown: Administrator, Admin, Sales, Warehouse, Technician, Shipper
              - Khi bấm Lưu sẽ gửi POST request đến UserController (action Create)
              - Khi bấm Hủy bỏ sẽ trở về trang danh sách User
*@
@model CMS.Data.Entities.User
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm thành viên";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary mb-0">THÊM THÀNH VIÊN MỚI</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>
<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Tên đăng nhập:</label>
                <input asp-for="Username" class="form-control"
                       placeholder="Nhập tên đăng nhập..." />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mật khẩu:</label>
                <input asp-for="PasswordHash" type="password" class="form-control"
                       placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Họ và tên:</label>
                <input asp-for="FullName" class="form-control"
                       placeholder="Nhập họ và tên..." />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Quyền hạn:</label>
                <select asp-for="Role" class="form-select">
                    <option value="">-- Chọn quyền hạn --</option>
                    <option value="Administrator">🔑 Administrator</option>
                    <option value="Admin">🏪 Admin — Quản lý cửa hàng</option>
                    <option value="Sales">💰 Sales — Nhân viên bán hàng</option>
                    <option value="Cashier">🧾 Cashier — Thu ngân</option>
                    <option value="Warehouse">📦 Warehouse — Thủ kho</option>
                    <option value="Technician">🔧 Technician — Kỹ thuật / Bảo hành</option>
                    <option value="Shipper">🚚 Shipper — Nhân viên giao hàng</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

          

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Lưu vào hệ thống
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const descriptions = {
            "Administrator": "✅ Full control 100%. Quản lý toàn bộ hệ thống, nhân sự, tài chính và cấu hình.",
            "Admin": "✅ Quản lý nghiệp vụ cửa hàng: sản phẩm, đơn hàng, khuyến mãi. ❌ Không xem được nhân sự và giá vốn.",
            "Sales": "✅ Tạo đơn hàng, thanh toán, tích điểm khách hàng. ❌ Không xóa đơn, không sửa giá, không xem lợi nhuận.",
            "Warehouse": "✅ Nhập/xuất kho, quản lý IMEI, kiểm kê. ❌ Không tạo đơn bán, không xem doanh thu.",
            "Technician": "✅ Tiếp nhận bảo hành, cập nhật tiến độ sửa chữa, quản lý linh kiện. ❌ Không bán hàng, không xem báo cáo.",
            "Shipper": "✅ Xem đơn được phân công, cập nhật trạng thái giao, xác nhận COD. ❌ Không sửa đơn, không xem tồn kho."
        };

        document.querySelector('[name="Role"]').addEventListener('change', function () {
            const desc = document.getElementById('role-description');
            if (this.value && descriptions[this.value]) {
                desc.textContent = descriptions[this.value];
                desc.classList.remove('d-none');
            } else {
                desc.classList.add('d-none');
            }
        });
    </script>
}