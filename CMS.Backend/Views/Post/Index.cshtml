@*
    Họ và tên: Nguyễn Văn Hà
    MSSV     : 2122110132
    Lớp      : CCQ2211D
    Ngày tạo : 16/05/2026
    Mô tả    : Giao diện danh sách bài viết (Post) — đã thêm phân trang gọn
*@
@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bài viết";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold mb-0">QUẢN LÝ BÀI VIẾT</h2>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-primary fs-6 px-3 py-2">Tổng: @ViewBag.Total bài viết</span>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Thêm mới
            </a>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            var plainText = System.Text.RegularExpressions.Regex.Replace(
            item.Content ?? "", "<.*?>", ""
            );
            <div class="col">
                <div class="card shadow-sm h-100 border-0 rounded-3 overflow-hidden">
                    <div class="position-relative overflow-hidden" style="height: 240px;">
                        <img src="@item.ImageUrl"
                             class="w-100 h-100 position-absolute top-50 start-50 translate-middle"
                             alt="@item.Title"
                             style="object-fit: cover;">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-info text-dark mb-2 align-self-start">
                            @(item.Category != null ? item.Category.Name : "Chưa phân loại")
                        </span>
                        <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                        <p class="card-text text-muted small text-truncate-3">@plainText</p>
                        <div class="mt-auto">
                            <p class="text-muted small mb-2">
                                <i class="bi bi-calendar3"></i>
                                @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-outline-danger btn-sm flex-grow-1">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm «@item.Title» không?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── PHÂN TRANG (gọn, chỉ hiện vài số trang quanh trang hiện tại) ── *@
    @if (ViewBag.TotalPages > 1)
    {
        int currentPage = ViewBag.CurrentPage;
        int totalPages = ViewBag.TotalPages;
        int startPage = Math.Max(1, currentPage - 2);
        int endPage = Math.Min(totalPages, currentPage + 2);
        var catParam = ViewBag.CategoryId != null ? "id=" + ViewBag.CategoryId + "&" : "";

        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination flex-wrap" style="max-width: 100%;">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Post?@catParam page=1">« Đầu</a>
                </li>
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Post?@catParam page=@(currentPage - 1)">‹ Trước</a>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/Post?@catParam page=@i">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Post?@catParam page=@(currentPage + 1)">Sau ›</a>
                </li>
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Post?@catParam page=@totalPages">Cuối »</a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted small">
            Trang @currentPage / @totalPages — Tổng @ViewBag.Total bài viết
        </p>
    }
</div>
<style>
    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
