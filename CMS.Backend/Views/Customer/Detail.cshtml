@model CMS.Data.Entities.Customer
@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4" style="max-width: 650px;">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-person-badge-fill text-primary"></i> CHI TIẾT KHÁCH HÀNG
        </h2>
        <a href="/Customer" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Thông tin khách hàng -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <!-- Avatar + Tên -->
            <div class="text-center mb-4">
                <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                <h4 class="fw-bold mt-2">@Model.FullName</h4>
                <span class="badge bg-info text-dark px-3 py-2">
                    <i class="bi bi-person-check-fill me-1"></i> Khách hàng
                </span>
            </div>

            <hr />

            <!-- Chi tiết -->
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td width="35%" class="text-muted fw-semibold">
                            <i class="bi bi-hash text-secondary me-2"></i> ID
                        </td>
                        <td class="fw-bold">#@Model.Id</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">
                            <i class="bi bi-person-fill text-primary me-2"></i> Họ và tên
                        </td>
                        <td>@Model.FullName</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">
                            <i class="bi bi-envelope-fill text-warning me-2"></i> Email
                        </td>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">
                            <i class="bi bi-telephone-fill text-success me-2"></i> Số điện thoại
                        </td>
                        <td>@(Model.Phone ?? "Chưa cập nhật")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">
                            <i class="bi bi-geo-alt-fill text-danger me-2"></i> Địa chỉ
                        </td>
                        <td>@(Model.Address ?? "Chưa cập nhật")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">
                            <i class="bi bi-bag-fill text-info me-2"></i> Số đơn hàng
                        </td>
                        <td>
                            <span class="badge bg-primary">
                                @(Model.Orders?.Count ?? 0) đơn
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">