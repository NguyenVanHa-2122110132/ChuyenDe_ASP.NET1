              - File nằm tại: Views/Customer/Index.cshtml
*@
@model IEnumerable<CMS.Data.Entities.Customer>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}
<div class="container mt-4">
    <!-- Tiêu đề trang trí chuyên nghiệp -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-person-badge-fill text-primary"></i> QUẢN LÝ KHÁCH HÀNG
        </h2>
        <span class="badge bg-primary fs-6 px-3 py-2">Tổng số khách: @Model.Count()</span>
    </div>
    <!-- Bảng danh sách khách hàng -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 text-center align-middle">
                <thead class="table-primary text-dark">
                    <tr>
                        <th width="8%">ID</th>
                        <th width="25%">Họ và tên khách hàng</th>
                        <th width="15%">Số điện thoại</th>
                        <th width="27%">Địa chỉ giao hàng</th>
                        <th width="15%">Quyền hạn</th>
                        <th width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@customer.Id</td>
                            <td class="text-start fw-semibold text-dark ps-4">
                                <i class="bi bi-person-circle text-secondary me-2"></i> @customer.FullName
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border p-2">
                                    <i class="bi bi-telephone-fill text-success me-1"></i> @customer.Phone
                                </span>
                            </td>
                            <td class="text-start text-muted ps-4">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @customer.Address
                            </td>
                            <td>
                                <span class="badge bg-info text-dark px-3 py-2">
                                    <i class="bi bi-person-check-fill me-1"></i> Khách hàng
                                </span>
                            </td>
                            <td class="d-flex gap-1 justify-content-center">
                                <a href="/Customer/Detail/@customer.Id"
                                   class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <form method="post" action="/Customer/Delete/@customer.Id"
                                      onsubmit="return confirmDelete('@customer.FullName')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khách hàng">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script>
    function confirmDelete(name) {
        return confirm('Bạn có chắc muốn xóa khách hàng "' + name + '" không?\nHành động này không thể hoàn tác!');
    }
</script>