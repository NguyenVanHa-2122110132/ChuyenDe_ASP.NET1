    Ngày tạo : 18/05/2026
    Mô tả    : Trang thêm mới liên kết Danh mục - Sản phẩm trong khu vực Admin.
              - Hiển thị form chọn Danh mục và Sản phẩm từ dropdown
              - Khi bấm Lưu sẽ gửi POST request đến ProductCategoryController (action Create)
              - Kiểm tra trùng lặp trước khi lưu vào database
*@
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Thêm liên kết Danh mục - Sản phẩm</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-body">
        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label class="form-label fw-bold">Danh mục:</label>
                <select name="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Sản phẩm:</label>
                <select name="ProductId" asp-items="ViewBag.Products" class="form-select">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Lưu
                </button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>

        </form>
    </div>
</div>