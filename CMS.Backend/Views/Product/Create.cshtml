@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container mt-4">
    <h2>Thêm sản phẩm mới</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả sản phẩm"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Price" class="control-label">Giá bán (₫)</label>
                        <input asp-for="Price" class="form-control" type="number" step="1000" min="0" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="OriginalPrice" class="control-label">Giá gốc (nếu sale)</label>
                        <input asp-for="OriginalPrice" class="form-control" type="number" step="1000" min="0" />
                        <span asp-validation-for="OriginalPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Gender" class="control-label">Giới tính</label>
                        <select asp-for="Gender" class="form-control">
                            <option value="">-- Chọn --</option>
                            <option value="nam">Nam</option>
                            <option value="nu">Nữ</option>
                            <option value="treem">Trẻ em</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Brand" class="control-label">Thương hiệu</label>
                        <input asp-for="Brand" class="form-control" placeholder="VD: Nike, Zara..." />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Sizes" class="control-label">Kích cỡ (cách nhau bằng dấu phẩy)</label>
                        <input asp-for="Sizes" class="form-control" placeholder="VD: S,M,L,XL" />
                        <span asp-validation-for="Sizes" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Colors" class="control-label">Màu sắc (cách nhau bằng dấu phẩy)</label>
                        <input asp-for="Colors" class="form-control" placeholder="VD: Đen,Trắng,Xanh" />
                        <span asp-validation-for="Colors" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Material" class="control-label">Chất liệu</label>
                        <input asp-for="Material" class="form-control" placeholder="VD: Cotton, Polyester..." />
                        <span asp-validation-for="Material" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3 col-md-6">
                        <label asp-for="Stock" class="control-label">Số lượng tồn kho</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Hình ảnh sản phẩm</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                </div>

                <div class="form-group mb-3 d-flex gap-4">
                    <div class="form-check">
                        <input asp-for="IsNew" class="form-check-input" />
                        <label asp-for="IsNew" class="form-check-label">Mới (New)</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsHot" class="form-check-input" />
                        <label asp-for="IsHot" class="form-check-label">Hot</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsSale" class="form-check-input" />
                        <label asp-for="IsSale" class="form-check-label">Sale</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label">Hiển thị (Active)</label>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Lưu sản phẩm" class="btn btn-success" />
                    <a asp-action="IndexAdmin" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}