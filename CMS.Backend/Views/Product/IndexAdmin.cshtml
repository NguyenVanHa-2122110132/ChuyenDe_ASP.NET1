@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý sản phẩm";

    int totalProducts = Model.Count();
    int inStock = Model.Count(p => p.Stock > 0);
    int outOfStock = Model.Count(p => p.Stock == 0);
    int onSale = Model.Count(p => p.IsSale);
}

<style>
    .summary-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .summary-card {
        background: #fff;
        border-radius: 12px;
        padding: 18px 20px;
        border: 1px solid #e8e8e8;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: box-shadow 0.2s;
    }

        .summary-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }

    .summary-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .icon-blue {
        background: #e8f0fe;
        color: #3b6fdb;
    }

    .icon-green {
        background: #e6f9ef;
        color: #1e9e5e;
    }

    .icon-orange {
        background: #fff3e0;
        color: #e67e22;
    }

    .icon-purple {
        background: #f3eeff;
        color: #7c4dff;
    }

    .summary-info .label {
        font-size: 12px;
        color: #888;
        margin-bottom: 2px;
    }

    .summary-info .value {
        font-size: 22px;
        font-weight: 600;
        color: #1a1a2e;
        line-height: 1.2;
    }

    .filter-bar {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

        .filter-bar .search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .filter-bar .search-wrap i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #aaa;
            }

        .filter-bar input[type="text"] {
            width: 100%;
            padding: 8px 12px 8px 36px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

            .filter-bar input[type="text"]:focus {
                border-color: #3b6fdb;
            }

        .filter-bar select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            background: #fafafa;
            outline: none;
            cursor: pointer;
        }

            .filter-bar select:focus {
                border-color: #3b6fdb;
            }

    .result-count {
        font-size: 13px;
        color: #888;
        margin-left: auto;
        white-space: nowrap;
    }

    .product-table {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
    }

        .product-table table {
            margin: 0;
            border: none;
        }

        .product-table thead th {
            background: #1a1a2e;
            color: #fff;
            font-weight: 500;
            font-size: 13px;
            padding: 14px 16px;
            border: none;
            letter-spacing: 0.3px;
        }

        .product-table tbody tr {
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.15s;
        }

            .product-table tbody tr:hover {
                background: #f8f9ff;
            }

            .product-table tbody tr:last-child {
                border-bottom: none;
            }

        .product-table tbody td {
            padding: 12px 16px;
            vertical-align: middle;
            border: none;
            font-size: 14px;
            color: #333;
        }

    .product-img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .no-image-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f5f5f5;
        color: #aaa;
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .price-text {
        font-weight: 600;
        color: #e74c3c;
        white-space: nowrap;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header h2 {
            font-size: 24px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

    .btn-add {
        background: #1e9e5e;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-add:hover {
            background: #178a50;
            color: #fff;
        }

    .no-result-row td {
        text-align: center;
        color: #aaa;
        padding: 40px !important;
        font-size: 14px;
    }
</style>

<div class="page-header">
    <h2><i class="bi bi-box-seam me-2"></i>Quản lý Sản phẩm</h2>
    <a asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle"></i> Thêm mới
    </a>
</div>

@* Summary Bar *@
<div class="summary-bar">
    <div class="summary-card">
        <div class="summary-icon icon-blue">
            <i class="bi bi-grid-3x3-gap"></i>
        </div>
        <div class="summary-info">
            <div class="label">Tổng sản phẩm</div>
            <div class="value">@totalProducts</div>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-icon icon-green">
            <i class="bi bi-check-circle"></i>
        </div>
        <div class="summary-info">
            <div class="label">Còn hàng</div>
            <div class="value">@inStock</div>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-icon icon-orange">
            <i class="bi bi-x-circle"></i>
        </div>
        <div class="summary-info">
            <div class="label">Hết hàng</div>
            <div class="value">@outOfStock</div>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-icon icon-purple">
            <i class="bi bi-tag"></i>
        </div>
        <div class="summary-info">
            <div class="label">Đang sale</div>
            <div class="value">@onSale</div>
        </div>
    </div>
</div>

@* Filter Bar *@
<div class="filter-bar">
    <div class="search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" placeholder="Tìm theo tên sản phẩm..." oninput="filterTable()" />
    </div>

    <select id="imageFilter" onchange="filterTable()">
        <option value="">Tất cả ảnh</option>
        <option value="has">Có ảnh</option>
        <option value="no">Chưa có ảnh</option>
    </select>

    <select id="priceFilter" onchange="filterTable()">
        <option value="">Tất cả giá</option>
        <option value="0-200000">Dưới 200.000đ</option>
        <option value="200000-500000">200.000 – 500.000đ</option>
        <option value="500000-99999999">Trên 500.000đ</option>
    </select>

    <span class="result-count" id="resultCount">Hiển thị @totalProducts sản phẩm</span>
</div>

@* Table *@
<div class="product-table">
    <table class="table table-hover mb-0" id="productTable">
        <thead>
            <tr>
                <th style="width:60px">ID</th>
                <th style="width:70px">Ảnh</th>
                <th>Tên sản phẩm</th>
                <th style="width:150px">Giá bán</th>
                <th>Mô tả</th>
                <th style="width:140px">Thao tác</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            @foreach (var item in Model)
            {
                <tr data-name="@item.Name.ToLower()"
                    data-price="@item.Price"
                    data-hasimage="@(!string.IsNullOrEmpty(item.ImageUrl) ? "has" : "no")">
                    <td>@item.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="product-img" alt="@item.Name" />
                        }
                        else
                        {
                            <span class="no-image-badge">
                                <i class="bi bi-image"></i> Chưa có
                            </span>
                        }
                    </td>
                    <td><strong>@item.Name</strong></td>
                    <td><span class="price-text">@item.Price.ToString("N0")đ</span></td>
                    <td style="color:#666">@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id"
                              method="post" style="display:inline"
                              onsubmit="return confirm('Xóa sản phẩm này?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
            <tr id="noResultRow" style="display:none;" class="no-result-row">
                <td colspan="6">
                    <i class="bi bi-search me-2"></i>Không tìm thấy sản phẩm phù hợp
                </td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase().trim();
        const imageFilter = document.getElementById('imageFilter').value;
        const priceFilter = document.getElementById('priceFilter').value;

        const rows = document.querySelectorAll('#tableBody tr:not(#noResultRow)');
        let visibleCount = 0;

        rows.forEach(row => {
            const name = row.getAttribute('data-name') || '';
            const price = parseFloat(row.getAttribute('data-price')) || 0;
            const hasImage = row.getAttribute('data-hasimage') || '';

            const matchName = name.includes(search);

            const matchImage = !imageFilter || hasImage === imageFilter;

            let matchPrice = true;
            if (priceFilter) {
                const [min, max] = priceFilter.split('-').map(Number);
                matchPrice = price >= min && price <= max;
            }

            if (matchName && matchImage && matchPrice) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('noResultRow').style.display = visibleCount === 0 ? '' : 'none';
        document.getElementById('resultCount').textContent = `Hiển thị ${visibleCount} sản phẩm`;
    }
</script>
