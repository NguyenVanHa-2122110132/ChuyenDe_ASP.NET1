    Ngày tạo : 04/06/2026
    Mô tả    : Giao diện quản lý danh sách sản phẩm (Admin)
              - Hiển thị dạng bảng admin chuyên nghiệp
              - Có nút Thêm mới, Sửa, Xóa
              - Có phân trang gọn (chỉ hiện vài số trang quanh trang hiện tại)
              - File nằm tại: Views/Product/Index.cshtml
*@
@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý sản phẩm";

    var frontendUrl = "http://localhost:3000";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold mb-0">
        <i class="bi bi-box-seam-fill"></i> QUẢN LÝ SẢN PHẨM
    </h2>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" action="/Product" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search"
                   placeholder="🔍 Tìm tên sản phẩm..."
                   class="form-control" style="width:260px;" />
            <button type="submit" class="btn btn-outline-primary">Tìm</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="/Product" class="btn btn-outline-secondary">✕ Xóa</a>
            }
        </form>
        <span class="badge bg-primary fs-6 px-3 py-2">Tổng: @ViewBag.Total sản phẩm</span>
        <a href="/Product/Create" class="btn btn-success">
            <i class="bi bi-plus-circle-fill"></i> Thêm sản phẩm
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th width="5%">ID</th>
                    <th width="8%">Ảnh</th>
                    <th width="20%" class="text-start ps-3">Tên sản phẩm</th>
                    <th width="17%" class="text-start">Mô tả</th>
                    <th width="12%">Giá</th>
                    <th width="10%">Tồn kho</th>
                    <th width="10%">Kích thước</th>
                    <th width="10%">Danh mục</th>
                    <th width="10%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">@item.Id</td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@(frontendUrl + item.ImageUrl)"
                                     alt="@item.Name"
                                     style="width:50px; height:50px; object-fit:cover;"
                                     class="rounded shadow-sm"
                                     onerror="this.onerror=null; this.src='https://placehold.co/50x50?text=No+Image'" />
                            }
                            else
                            {
                                <i class="bi bi-image text-muted fs-4"></i>
                            }
                        </td>

                        <td class="text-start ps-3 fw-semibold">@item.Name</td>

                        <td class="text-start text-muted small">
                            <span title="@item.Description">
                                @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                            </span>
                        </td>

                        <td class="text-danger fw-bold">
                            @item.Price.ToString("N0") <small class="text-muted fw-normal">đ</small>
                        </td>

                        <td>
                            @if (item.Stock <= 5)
                            {
                                <span class="badge bg-danger">@item.Stock</span>
                            }
                            else if (item.Stock <= 20)
                            {
                                <span class="badge bg-warning text-dark">@item.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.Stock</span>
                            }
                        </td>

                        <td class="text-muted small fw-semibold">@item.Sizes</td>

                        <td>
                            @if (item.CategoryProducts != null && item.CategoryProducts.Any())
                            {
                                foreach (var cp in item.CategoryProducts)
                                {
                                    <span class="badge bg-secondary me-1">@cp.Category?.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-1 justify-content-center">
                                <a href="/Product/Details/@item.Id"
                                   class="btn btn-sm btn-outline-info" title="Chi tiết">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a href="/Product/Edit/@item.Id"
                                   class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form method="post" action="/Product/Delete/@item.Id"
                                      onsubmit="return confirm('Xóa sản phẩm \'@item.Name\'?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── PHÂN TRANG (gọn, chỉ hiện vài số trang quanh trang hiện tại) ── *@
@if (ViewBag.TotalPages > 1)
{
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination flex-wrap" style="max-width: 100%;">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Product?search=@ViewBag.Search&page=1">« Đầu</a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Product?search=@ViewBag.Search&page=@(currentPage - 1)">‹ Trước</a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="/Product?search=@ViewBag.Search&page=@i">@i</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="/Product?search=@ViewBag.Search&page=@(currentPage + 1)">Sau ›</a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="/Product?search=@ViewBag.Search&page=@totalPages">Cuối »</a>
            </li>
        </ul>
    </nav>
    <p class="text-center text-muted small">
        Trang @currentPage / @totalPages — Tổng @ViewBag.Total sản phẩm
    </p>
}
